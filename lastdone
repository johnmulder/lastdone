def database_path() -> Path:
    configured = os.environ.get("LASTDONE_DB")
    if configured:
        return expanded_path(configured)
    data_home = os.environ.get("XDG_DATA_HOME")
    root = expanded_path(data_home) if data_home else Path.home() / ".local/share"
    return root / "last" / "last.db"


def create_events_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE events (
            id TEXT NOT NULL PRIMARY KEY
                CONSTRAINT events_id_nonempty CHECK (length(id) > 0),
            name TEXT NOT NULL
                CONSTRAINT events_name_nonempty CHECK (length(name) > 0),
            occurred_at TEXT,
            occurred_on TEXT,
            note TEXT,
            CONSTRAINT events_occurrence_exactly_one CHECK (
                (occurred_at IS NOT NULL) <> (occurred_on IS NOT NULL)
            ),
            CONSTRAINT events_occurred_at_valid CHECK (
                occurred_at IS NULL OR (
                    length(occurred_at) = 27
                    AND occurred_at GLOB (
                        '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T' ||
                        '[0-9][0-9]:[0-9][0-9]:[0-9][0-9].' ||
                        '[0-9][0-9][0-9][0-9][0-9][0-9]Z'
                    )
                    AND coalesce(
                        datetime(substr(occurred_at, 1, 19), '+0 seconds') =
                            replace(substr(occurred_at, 1, 19), 'T', ' '),
                        0
                    )
                )
            ),
            CONSTRAINT events_occurred_on_valid CHECK (
                occurred_on IS NULL OR (
                    length(occurred_on) = 10
                    AND occurred_on GLOB
                        '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
                    AND coalesce(
                        date(occurred_on, '+0 days') = occurred_on,
                        0
                    )
                )
            )
        )
        """
    )


def create_corrections_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE corrections (
            id TEXT NOT NULL PRIMARY KEY
                CONSTRAINT corrections_id_nonempty CHECK (length(id) > 0),
            kind TEXT NOT NULL
                CONSTRAINT corrections_kind_valid
                CHECK (kind IN ('void', 'replace')),
            target_id TEXT NOT NULL
                CONSTRAINT corrections_target_unique UNIQUE
                REFERENCES events(id),
            replacement_id TEXT
                CONSTRAINT corrections_replacement_unique UNIQUE
                REFERENCES events(id),
            reason TEXT NOT NULL
                CONSTRAINT corrections_reason_nonempty CHECK (length(reason) > 0),
            corrected_at TEXT NOT NULL
                CONSTRAINT corrections_corrected_at_valid CHECK (
                    length(corrected_at) = 27
                    AND corrected_at GLOB (
                        '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T' ||
                        '[0-9][0-9]:[0-9][0-9]:[0-9][0-9].' ||
                        '[0-9][0-9][0-9][0-9][0-9][0-9]Z'
                    )
                    AND coalesce(
                        datetime(substr(corrected_at, 1, 19), '+0 seconds') =
                            replace(substr(corrected_at, 1, 19), 'T', ' '),
                        0
                    )
                ),
            CONSTRAINT corrections_relationship_valid CHECK (
                (kind = 'void' AND replacement_id IS NULL)
                OR (kind = 'replace' AND replacement_id IS NOT NULL)
            ),
            CONSTRAINT corrections_distinct_events CHECK (
                replacement_id IS NULL OR target_id <> replacement_id
            )
        )
        """
    )


def create_version_3_activities_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE activities (
            name TEXT NOT NULL PRIMARY KEY
                CONSTRAINT activities_name_nonempty CHECK (length(name) > 0),
            expected_interval_days INTEGER NOT NULL
                CONSTRAINT activities_interval_positive CHECK (
                    typeof(expected_interval_days) = 'integer'
                    AND expected_interval_days > 0
                )
        )
        """
    )


def create_activities_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE activities (
            name TEXT NOT NULL PRIMARY KEY
                CONSTRAINT activities_name_nonempty CHECK (length(name) > 0),
            expected_interval_days INTEGER
                CONSTRAINT activities_interval_positive CHECK (
                    expected_interval_days IS NULL OR (
                        typeof(expected_interval_days) = 'integer'
                        AND expected_interval_days > 0
                    )
                ),
            display_name TEXT
                CONSTRAINT activities_display_name_nonempty CHECK (
                    display_name IS NULL OR length(display_name) > 0
                ),
            CONSTRAINT activities_metadata_present CHECK (
                expected_interval_days IS NOT NULL OR display_name IS NOT NULL
            )
        )
        """
    )


def table_columns(database: sqlite3.Connection) -> tuple[str, ...]:
    return tuple(row["name"] for row in database.execute("PRAGMA table_info(events)"))


def correction_columns(database: sqlite3.Connection) -> tuple[str, ...]:
    return tuple(
        row["name"] for row in database.execute("PRAGMA table_info(corrections)")
    )


def activity_columns(database: sqlite3.Connection) -> tuple[str, ...]:
    return tuple(
        row["name"] for row in database.execute("PRAGMA table_info(activities)")
    )


def migrate_to_version_1(database: sqlite3.Connection) -> None:
    columns = table_columns(database)
    if not columns:
        create_events_table(database)
    else:
        legacy_columns = ("id", "name", "occurred_at", "note")
        precision_columns = ("id", "name", "occurred_at", "occurred_on", "note")
        if columns not in (legacy_columns, precision_columns):
            raise sqlite3.DatabaseError("unrecognized unversioned events schema")
        database.execute("ALTER TABLE events RENAME TO events_legacy")
        create_events_table(database)
        if columns == legacy_columns:
            database.execute(
                """
                INSERT INTO events (id, name, occurred_at, occurred_on, note)
                SELECT id, name, occurred_at, NULL, note
                FROM events_legacy
                """
            )
        else:
            database.execute(
                """
                INSERT INTO events (id, name, occurred_at, occurred_on, note)
                SELECT id, name, occurred_at, occurred_on, note
                FROM events_legacy
                """
            )
        database.execute("DROP TABLE events_legacy")
    database.execute("CREATE INDEX idx_events_name ON events(name)")


def migrate_to_version_2(database: sqlite3.Connection) -> None:
    create_corrections_table(database)


def migrate_to_version_3(database: sqlite3.Connection) -> None:
    create_version_3_activities_table(database)


def migrate_to_version_4(database: sqlite3.Connection) -> None:
    database.execute("ALTER TABLE activities RENAME TO activities_legacy")
    create_activities_table(database)
    database.execute(
        """
        INSERT INTO activities
            (name, expected_interval_days, display_name)
        SELECT name, expected_interval_days, NULL
        FROM activities_legacy
        """
    )
    database.execute("DROP TABLE activities_legacy")


def migrate_to_version_5(database: sqlite3.Connection) -> None:
    database.execute("ALTER TABLE events ADD COLUMN reading_value TEXT")
    database.execute(
        """
        ALTER TABLE events ADD COLUMN reading_unit TEXT
            CONSTRAINT events_reading_valid CHECK (
                (reading_value IS NULL AND reading_unit IS NULL) OR (
                    typeof(reading_value) = 'text'
                    AND length(reading_value) > 0
                    AND reading_value NOT GLOB '*[^0-9.]*'
                    AND reading_value NOT LIKE '.%'
                    AND reading_value NOT LIKE '%.'
                    AND reading_value NOT LIKE '%.%.%'
                    AND (
                        reading_value = '0'
                        OR reading_value NOT GLOB '0[0-9]*'
                    )
                    AND (
                        instr(reading_value, '.') = 0
                        OR substr(reading_value, -1) <> '0'
                    )
                    AND typeof(reading_unit) = 'text'
                    AND reading_unit GLOB '[a-z]*'
                    AND reading_unit NOT GLOB '*[^a-z-]*'
                    AND reading_unit NOT LIKE '%-'
                    AND reading_unit NOT LIKE '%--%'
                )
            )
        """
    )


MIGRATIONS = (
    migrate_to_version_1,
    migrate_to_version_2,
    migrate_to_version_3,
    migrate_to_version_4,
    migrate_to_version_5,
)


def database_schema_version(database: sqlite3.Connection) -> int:
    return database.execute("PRAGMA user_version").fetchone()[0]


def backup_before_migration(
    database: sqlite3.Connection, path: Path, source_version: int
) -> None:
    if source_version == 0 and not table_columns(database):
        return
    backup_path = path.with_name(f"{path.name}.v{source_version}.bak")
    if backup_path.exists():
        return
    backup = sqlite3.connect(backup_path)
    try:
        database.backup(backup)
    except Exception:
        backup.close()
        try:
            backup_path.unlink()
        except OSError:
            pass
        raise
    backup.close()
    if os.name == "posix":
        os.chmod(backup_path, 0o600)


def validate_schema_structure(database: sqlite3.Connection) -> None:
    expected_columns = (
        "id",
        "name",
        "occurred_at",
        "occurred_on",
        "note",
        "reading_value",
        "reading_unit",
    )
    if table_columns(database) != expected_columns:
        raise sqlite3.DatabaseError("database schema does not match its version")
    table_sql_row = database.execute(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'events'"
    ).fetchone()
    table_sql = table_sql_row["sql"] if table_sql_row else ""
    markers = (
        "events_id_nonempty",
        "events_name_nonempty",
        "events_occurrence_exactly_one",
        "events_occurred_at_valid",
        "events_occurred_on_valid",
        "events_reading_valid",
    )
    if any(marker not in table_sql for marker in markers):
        raise sqlite3.DatabaseError("database schema does not match its version")
    indexes = {
        row["name"] for row in database.execute("PRAGMA index_list(events)")
    }
    if "idx_events_name" not in indexes:
        raise sqlite3.DatabaseError("database schema does not match its version")
    expected_correction_columns = (
        "id",
        "kind",
        "target_id",
        "replacement_id",
        "reason",
        "corrected_at",
    )
    if correction_columns(database) != expected_correction_columns:
        raise sqlite3.DatabaseError("database schema does not match its version")
    correction_sql_row = database.execute(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'corrections'"
    ).fetchone()
    correction_sql = correction_sql_row["sql"] if correction_sql_row else ""
    correction_markers = (
        "corrections_id_nonempty",
        "corrections_kind_valid",
        "corrections_target_unique",
        "corrections_replacement_unique",
        "corrections_reason_nonempty",
        "corrections_corrected_at_valid",
        "corrections_relationship_valid",
        "corrections_distinct_events",
    )
    if any(marker not in correction_sql for marker in correction_markers):
        raise sqlite3.DatabaseError("database schema does not match its version")
    if activity_columns(database) != (
        "name",
        "expected_interval_days",
        "display_name",
    ):
        raise sqlite3.DatabaseError("database schema does not match its version")
    activity_sql_row = database.execute(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'activities'"
    ).fetchone()
    activity_sql = activity_sql_row["sql"] if activity_sql_row else ""
    activity_markers = (
        "activities_name_nonempty",
        "activities_interval_positive",
        "activities_display_name_nonempty",
        "activities_metadata_present",
    )
    if any(marker not in activity_sql for marker in activity_markers):
        raise sqlite3.DatabaseError("database schema does not match its version")


def validate_schema(database: sqlite3.Connection) -> None:
    validate_schema_structure(database)
    integrity = database.execute("PRAGMA integrity_check(1)").fetchone()[0]
    if integrity != "ok":
        raise sqlite3.DatabaseError(f"database integrity check failed: {integrity}")
    foreign_key_problem = database.execute("PRAGMA foreign_key_check").fetchone()
    if foreign_key_problem is not None:
        raise sqlite3.DatabaseError("database foreign key check failed")


def apply_migrations(database: sqlite3.Connection, path: Path) -> None:
    version = database_schema_version(database)
    if version > SCHEMA_VERSION:
        raise sqlite3.DatabaseError(
            f"database schema version {version} is newer than supported version "
            f"{SCHEMA_VERSION}"
        )
    if version in (0, 3):
        backup_before_migration(database, path, version)
    while version < SCHEMA_VERSION:
        database.execute("BEGIN IMMEDIATE")
        try:
            version = database_schema_version(database)
            if version > SCHEMA_VERSION:
                raise sqlite3.DatabaseError(
                    f"database schema version {version} is newer than supported "
                    f"version {SCHEMA_VERSION}"
                )
            if version == SCHEMA_VERSION:
                database.commit()
                break
            target_version = version + 1
            MIGRATIONS[target_version - 1](database)
            database.execute(f"PRAGMA user_version = {target_version}")
            database.commit()
            version = target_version
        except Exception:
            database.rollback()
            raise
    validate_schema(database)


def prepare_storage(path: Path) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)


def connect_database(path: Path) -> sqlite3.Connection:
    prepare_storage(path)
    database = sqlite3.connect(path, timeout=BUSY_TIMEOUT_SECONDS)
    database.row_factory = sqlite3.Row
    database.execute("PRAGMA foreign_keys = ON")
    try:
        apply_migrations(database, path)
        if os.name == "posix":
            os.chmod(path, 0o600)
    except Exception:
        database.close()
        raise
    return database


def connect_read_only(path: Path) -> tuple[Path, sqlite3.Connection]:
    resolved = path.resolve()
    database = sqlite3.connect(
        f"{resolved.as_uri()}?mode=ro",
        uri=True,
        timeout=BUSY_TIMEOUT_SECONDS,
    )
    database.row_factory = sqlite3.Row
    database.execute("PRAGMA foreign_keys = ON")
    return resolved, database


def current_timestamp(now: datetime) -> str:
    return (
        now.astimezone(timezone.utc)
        .isoformat(timespec="microseconds")
        .replace("+00:00", "Z")
    )


def event_values(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {
        "id": row["id"],
        "name": row["name"],
        "occurred_at": row["occurred_at"],
        "occurred_on": row["occurred_on"],
        "note": row["note"],
        "reading_value": row["reading_value"],
        "reading_unit": row["reading_unit"],
    }


def event_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {"schema_version": 2, "type": "event", **event_values(row)}


def correction_values(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {
        "id": row["id"],
        "kind": row["kind"],
        "target_id": row["target_id"],
        "replacement_id": row["replacement_id"],
        "reason": row["reason"],
        "corrected_at": row["corrected_at"],
    }


def correction_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {"schema_version": 2, "type": "correction", **correction_values(row)}


def activity_values(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {
        "name": row["name"],
        "expected_interval_days": row["expected_interval_days"],
        "display_name": row["display_name"],
    }


def activity_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {
        "schema_version": 2,
        "type": "activity",
        **activity_values(row),
    }


def interchange_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {"record_version": 5, "type": "event", **event_values(row)}


def correction_interchange_record(
    row: sqlite3.Row | dict[str, Any],
) -> dict[str, Any]:
    return {"record_version": 5, "type": "correction", **correction_values(row)}


def activity_interchange_record(
    row: sqlite3.Row | dict[str, Any],
) -> dict[str, Any]:
    return {"record_version": 5, "type": "activity", **activity_values(row)}


def emit_json(record: dict[str, Any]) -> None:
    print(json.dumps(record, ensure_ascii=False, separators=(",", ":")))


def rows_for_activity(
    database: sqlite3.Connection, name: str
) -> list[sqlite3.Row]:
    rows = database.execute(
        """
        SELECT rowid AS insertion_order, id, name, occurred_at, occurred_on, note,
               reading_value, reading_unit
        FROM events
        WHERE name = ?
          AND NOT EXISTS (
              SELECT 1 FROM corrections WHERE target_id = events.id
          )
        """,
        (name,),
    ).fetchall()
    return sorted(rows, key=occurrence_sort_key, reverse=True)


def local_date(timestamp: str) -> date:
    return datetime.fromisoformat(timestamp.replace("Z", "+00:00")).astimezone().date()


def occurrence_date(row: sqlite3.Row | dict[str, Any]) -> date:
    if row["occurred_on"] is not None:
        return date.fromisoformat(row["occurred_on"])
    return local_date(row["occurred_at"])


def occurrence_sort_key(
    row: sqlite3.Row | dict[str, Any],
) -> tuple[date, bool, str, int]:
    return (
        occurrence_date(row),
        row["occurred_at"] is not None,
        row["occurred_at"] or "",
        row["insertion_order"],
    )


def decimal_difference(current: str, previous: str) -> str:
    digit_count = sum(character.isdigit() for character in current + previous)
    with localcontext() as context:
        context.prec = digit_count + 1
        difference = Decimal(current) - Decimal(previous)
    return canonical_decimal(format(difference, "f"))


def reading_text(row: sqlite3.Row | dict[str, Any]) -> str:
    if row["reading_value"] is None:
        return "-"
    return f"{row['reading_value']}{row['reading_unit']}"


def validate_reading_order(
    database: sqlite3.Connection,
    event: dict[str, Any],
    *,
    allow_decrease: bool,
    exclude_id: str | None = None,
) -> None:
    if event["reading_value"] is None:
        if allow_decrease:
            raise InvalidReading("--allow-decrease requires a reading")
        return
    if allow_decrease:
        return

    exclusion = " AND id <> ?" if exclude_id is not None else ""
    parameters: tuple[str, ...] = (event["name"], event["reading_unit"])
    if exclude_id is not None:
        parameters += (exclude_id,)
    rows = database.execute(
        f"""
        SELECT rowid AS insertion_order,
               id, name, occurred_at, occurred_on, note,
               reading_value, reading_unit
        FROM events
        WHERE name = ? AND reading_unit = ?{exclusion}
          AND NOT EXISTS (
              SELECT 1 FROM corrections WHERE target_id = events.id
          )
        """,
        parameters,
    ).fetchall()
    candidate = {
        **event,
        "insertion_order": database.execute(
            "SELECT coalesce(max(rowid), 0) + 1 FROM events"
        ).fetchone()[0],
    }
    ordered = sorted((*rows, candidate), key=occurrence_sort_key)
    position = next(
        index for index, row in enumerate(ordered) if row is candidate
    )
    value = Decimal(event["reading_value"])
    decreases = (
        position > 0 and value < Decimal(ordered[position - 1]["reading_value"])
    ) or (
        position + 1 < len(ordered)
        and value > Decimal(ordered[position + 1]["reading_value"])
    )
    if decreases:
        raise InvalidReading(
            "reading would decrease; use --allow-decrease to confirm a reset"
        )


def occurrence_record(row: sqlite3.Row) -> dict[str, str | None]:
    return {"occurred_at": row["occurred_at"], "occurred_on": row["occurred_on"]}


def add_event(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    reading_value, reading_unit = args.reading or (None, None)
    event = {
        "id": str(uuid4()),
        "name": args.name,
        "occurred_at": None if args.occurred_on else current_timestamp(args.now),
        "occurred_on": args.occurred_on,
        "note": None,
        "reading_value": reading_value,
        "reading_unit": reading_unit,
    }
    database.execute("BEGIN IMMEDIATE")
    try:
        validate_reading_order(
            database,
            event,
            allow_decrease=args.allow_decrease,
        )
        database.execute(
            """
            INSERT INTO events
                (id, name, occurred_at, occurred_on, note,
                 reading_value, reading_unit)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            """,
            tuple(event.values()),
        )
        database.commit()
    except Exception:
        database.rollback()
        raise
    if args.jsonl:
        emit_json(event_record(event))
    return 0


def uncorrected_event(
    database: sqlite3.Connection, requested_id: str
) -> sqlite3.Row:
    event = database.execute(
        """
        SELECT id, name, occurred_at, occurred_on, note,
               reading_value, reading_unit
        FROM events
        WHERE id = ?
        """,
        (requested_id,),
    ).fetchone()
    if event is None:
        raise EventNotFound(requested_id)
    correction = database.execute(
        "SELECT 1 FROM corrections WHERE target_id = ?",
        (requested_id,),
    ).fetchone()
    if correction is not None:
        raise EventAlreadyCorrected(requested_id)
    return event


def store_correction(
    database: sqlite3.Connection,
    *,
    kind: str,
    target_id: str,
    replacement_id: str | None,
    reason: str,
    now: datetime,
) -> dict[str, Any]:
    correction = {
        "id": str(uuid4()),
        "kind": kind,
        "target_id": target_id,
        "replacement_id": replacement_id,
        "reason": reason,
        "corrected_at": current_timestamp(now),
    }
    database.execute(
        """
        INSERT INTO corrections
            (id, kind, target_id, replacement_id, reason, corrected_at)
        VALUES (?, ?, ?, ?, ?, ?)
        """,
        tuple(correction.values()),
    )
    return correction


def void_event(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    database.execute("BEGIN IMMEDIATE")
    try:
        uncorrected_event(database, args.event_id)
        correction = store_correction(
            database,
            kind="void",
            target_id=args.event_id,
            replacement_id=None,
            reason=args.reason,
            now=args.now,
        )
        database.commit()
    except Exception:
        database.rollback()
        raise
    if args.jsonl:
        emit_json(correction_record(correction))
    return 0


def replace_event(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    changed_fields = ("name", "occurred_on", "note", "reading")
    if not any(hasattr(args, field) for field in changed_fields):
        raise InvalidCorrection(
            "replace requires at least one of --name, --date, --note, or --reading"
        )
    database.execute("BEGIN IMMEDIATE")
    try:
        target = uncorrected_event(database, args.event_id)
        date_changed = hasattr(args, "occurred_on")
        replacement = {
            "id": str(uuid4()),
            "name": args.name if hasattr(args, "name") else target["name"],
            "occurred_at": None if date_changed else target["occurred_at"],
            "occurred_on": (
                args.occurred_on if date_changed else target["occurred_on"]
            ),
            "note": args.note if hasattr(args, "note") else target["note"],
            "reading_value": (
                args.reading[0]
                if hasattr(args, "reading")
                else target["reading_value"]
            ),
            "reading_unit": (
                args.reading[1]
                if hasattr(args, "reading")
                else target["reading_unit"]
            ),
        }
        validate_reading_order(
            database,
            replacement,
            allow_decrease=args.allow_decrease,
            exclude_id=args.event_id,
        )
        database.execute(
            """
            INSERT INTO events
                (id, name, occurred_at, occurred_on, note,
                 reading_value, reading_unit)
            VALUES (?, ?, ?, ?, ?, ?, ?)
            """,
            tuple(replacement.values()),
        )
        correction = store_correction(
            database,
            kind="replace",
            target_id=args.event_id,
            replacement_id=replacement["id"],
            reason=args.reason,
            now=args.now,
        )
        database.commit()
    except Exception:
        database.rollback()
        raise
    if args.jsonl:
        emit_json(correction_record(correction))
    return 0


def show_activity(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = rows_for_activity(database, args.name)
    if not rows:
        raise ActivityNotFound(args.name)

    latest = rows[0]
    previous = rows[1] if len(rows) > 1 else None
    interval = (
        (occurrence_date(latest) - occurrence_date(previous)).days
        if previous
        else None
    )
    metadata = database.execute(
        "SELECT display_name FROM activities WHERE name = ?",
        (args.name,),
    ).fetchone()
    configured_display_name = metadata["display_name"] if metadata else None
    reading_change = None
    if latest["reading_value"] is not None:
        previous_reading = next(
            (
                row
                for row in rows[1:]
                if row["reading_unit"] == latest["reading_unit"]
            ),
            None,
        )
        if previous_reading is not None:
            reading_change = decimal_difference(
                latest["reading_value"], previous_reading["reading_value"]
            )
    if args.jsonl:
        emit_json(
            {
                "schema_version": 2,
                "type": "summary",
                "name": args.name,
                "display_name": configured_display_name,
                "last": occurrence_record(latest),
                "previous": occurrence_record(previous) if previous else None,
                "interval_days": interval,
                "reading_value": latest["reading_value"],
                "reading_unit": latest["reading_unit"],
                "reading_change": reading_change,
                "occurrences": len(rows),
            }
        )
        return 0

    print(
        f"{configured_display_name} [{args.name}]"
        if configured_display_name
        else args.name
    )
    print(f"Last: {occurrence_date(latest).isoformat()}")
    print(
        f"Previous: {occurrence_date(previous).isoformat()}"
        if previous
        else "Previous: -"
    )
    print(f"Interval: {interval} days" if interval is not None else "Interval: -")
    if latest["reading_value"] is None:
        print("Reading: -")
    else:
        change = (
            f" ({'+' if not reading_change.startswith('-') else ''}"
            f"{reading_change}{latest['reading_unit']})"
            if reading_change is not None
            else ""
        )
        print(f"Reading: {reading_text(latest)}{change}")
    print(f"Occurrences: {len(rows)}")
    return 0


def show_history(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    if args.include_corrections:
        return show_audit_history(database, args)
    rows = rows_for_activity(database, args.name)
    if not rows:
        raise ActivityNotFound(args.name)
    for row in rows:
        if args.jsonl:
            emit_json(event_record(row))
        else:
            print(
                f"{row['id']}  {occurrence_date(row).isoformat()}  "
                f"{reading_text(row)}"
            )
    return 0


def show_audit_history(
    database: sqlite3.Connection, args: argparse.Namespace
) -> int:
    corrections = database.execute(
        """
        SELECT c.rowid AS insertion_order,
               c.id, c.kind, c.target_id, c.replacement_id,
               c.reason, c.corrected_at
        FROM corrections AS c
        JOIN events AS target ON target.id = c.target_id
        LEFT JOIN events AS replacement ON replacement.id = c.replacement_id
        WHERE target.name = ? OR replacement.name = ?
        ORDER BY c.rowid
        """,
        (args.name, args.name),
    ).fetchall()
    linked_ids = sorted(
        {
            linked_id
            for correction in corrections
            for linked_id in (
                correction["target_id"],
                correction["replacement_id"],
            )
            if linked_id is not None
        }
    )
    placeholders = ",".join("?" for _ in linked_ids)
    linked_clause = f" OR id IN ({placeholders})" if linked_ids else ""
    events = database.execute(
        f"""
        SELECT rowid AS insertion_order,
               id, name, occurred_at, occurred_on, note,
               reading_value, reading_unit
        FROM events
        WHERE name = ?{linked_clause}
        ORDER BY rowid
        """,
        (args.name, *linked_ids),
    ).fetchall()
    if not events and not corrections:
        raise ActivityNotFound(args.name)
    for event in events:
        if args.jsonl:
            emit_json(event_record(event))
        else:
            print(
                f"event {event['id']} {occurrence_date(event).isoformat()} "
                f"{reading_text(event)}"
            )
    for correction in corrections:
        if args.jsonl:
            emit_json(correction_record(correction))
        else:
            replacement = correction["replacement_id"] or "-"
            print(
                f"correction {correction['id']} {correction['kind']} "
                f"{correction['target_id']} {replacement} "
                f"{correction['corrected_at']} {correction['reason']}"
            )
    return 0


def list_activities(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = database.execute(
        """
        WITH names AS (
            SELECT name
            FROM events
            WHERE NOT EXISTS (
                SELECT 1 FROM corrections WHERE target_id = events.id
            )
            UNION
            SELECT name FROM activities
        )
        SELECT names.name, activities.expected_interval_days,
               activities.display_name
        FROM names
        LEFT JOIN activities ON activities.name = names.name
        ORDER BY names.name COLLATE BINARY
        """
    ).fetchall()
    for row in rows:
        if args.jsonl:
            emit_json(activity_record(row))
        else:
            print(
                f"{row['name']}  {row['display_name']}"
                if row["display_name"]
                else row["name"]
            )
    return 0


def set_interval(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    fields = ("expected_interval_days", "display_name")
    if not any(hasattr(args, field) for field in fields):
        raise InvalidActivityUpdate(
            "set requires at least one of --every or --display-name"
        )
    with database:
        database.execute(
            """
            INSERT INTO activities (name, expected_interval_days, display_name)
            VALUES (?, ?, ?)
            ON CONFLICT(name) DO UPDATE SET
                expected_interval_days = CASE WHEN ?
                    THEN excluded.expected_interval_days
                    ELSE activities.expected_interval_days END,
                display_name = CASE WHEN ?
                    THEN excluded.display_name ELSE activities.display_name END
            """,
            (
                args.name,
                getattr(args, "expected_interval_days", None),
                getattr(args, "display_name", None),
                hasattr(args, "expected_interval_days"),
                hasattr(args, "display_name"),
            ),
        )
        activity = database.execute(
            """
            SELECT name, expected_interval_days, display_name
            FROM activities WHERE name = ?
            """,
            (args.name,),
        ).fetchone()
    if args.jsonl:
        emit_json(activity_record(activity))
    return 0


def due_record(
    database: sqlite3.Connection,
    activity: sqlite3.Row,
    today: date,
) -> dict[str, Any]:
    rows = rows_for_activity(database, activity["name"])
    if not rows:
        last = None
        due_on = None
        state = "never-recorded"
    else:
        latest = rows[0]
        last = occurrence_record(latest)
        latest_date = occurrence_date(latest)
        due_ordinal = latest_date.toordinal() + activity["expected_interval_days"]
        due_on = (
            date.fromordinal(due_ordinal).isoformat()
            if due_ordinal <= date.max.toordinal()
            else None
        )
        if latest_date > today:
            state = "future-dated"
        elif due_ordinal < today.toordinal():
            state = "overdue"
        elif due_ordinal == today.toordinal():
            state = "due-today"
        else:
            state = "not-due"
    return {
        "schema_version": 2,
        "type": "due",
        **activity_values(activity),
        "last": last,
        "due_on": due_on,
        "state": state,
    }


def show_due(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    activities = database.execute(
        """
        SELECT name, expected_interval_days, display_name
        FROM activities
        WHERE expected_interval_days IS NOT NULL
        ORDER BY name COLLATE BINARY
        """
    )
    for activity in activities:
        record = due_record(database, activity, args.now.date())
        if args.overdue and record["state"] != "overdue":
            continue
        if args.jsonl:
            emit_json(record)
        else:
            last_date = (
                occurrence_date(record["last"]).isoformat()
                if record["last"] is not None
                else "-"
            )
            print(
                f"{record['name']}  {activity['display_name'] or '-'}  "
                f"{last_date}  "
                f"{record['expected_interval_days']}d  "
                f"{record['due_on'] or '-'}  {record['state'].upper()}"
            )
    return 0


def export_events(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    with database:
        database.execute("BEGIN")
        rows = database.execute(
            """
            SELECT id, name, occurred_at, occurred_on, note,
                   reading_value, reading_unit
            FROM events
            ORDER BY rowid
            """
        )
        for row in rows:
            emit_json(interchange_record(row))
        corrections = database.execute(
            """
            SELECT id, kind, target_id, replacement_id, reason, corrected_at
            FROM corrections
            ORDER BY rowid
            """
        )
        for correction in corrections:
            emit_json(correction_interchange_record(correction))
        activities = database.execute(
            """
            SELECT name, expected_interval_days, display_name
            FROM activities
            ORDER BY name COLLATE BINARY
            """
        )
        for activity in activities:
            emit_json(activity_interchange_record(activity))
    return 0


def valid_import_timestamp(value: str) -> bool:
    if len(value) != 27 or not value.endswith("Z"):
        return False
    try:
        parsed = datetime.fromisoformat(f"{value[:-1]}+00:00")
    except ValueError:
        return False
    return current_timestamp(parsed) == value


def parse_event_import_record(
    record: dict[str, Any], line_number: int
) -> dict[str, Any]:
    version = record.get("record_version")
    old_fields = {
        "record_version",
        "type",
        "id",
        "name",
        "occurred_at",
        "occurred_on",
        "note",
    }
    version_5_fields = {*old_fields, "reading_value", "reading_unit"}
    if type(version) is not int or version not in (1, 2, 3, 4, 5):
        raise InvalidImport(f"line {line_number}: unsupported record version")
    if set(record) != (version_5_fields if version == 5 else old_fields):
        raise InvalidImport(f"line {line_number}: expected event record fields")
    for field in ("id", "name"):
        value = record[field]
        if not isinstance(value, str) or not value:
            raise InvalidImport(
                f"line {line_number}: {field} must be a non-empty string"
            )
    if record["note"] is not None and not isinstance(record["note"], str):
        raise InvalidImport(f"line {line_number}: note must be a string or null")
    text_values = (record["id"], record["name"], record["note"] or "")
    try:
        for value in text_values:
            value.encode("utf-8")
    except UnicodeEncodeError:
        raise InvalidImport(f"line {line_number}: text must be valid UTF-8") from None
    if any(
        not character.isprintable()
        for value in text_values
        for character in value
    ):
        raise InvalidImport(f"line {line_number}: text must be printable")

    occurred_at = record["occurred_at"]
    occurred_on = record["occurred_on"]
    if (occurred_at is None) == (occurred_on is None):
        raise InvalidImport(
            f"line {line_number}: exactly one occurrence field is required"
        )
    if occurred_at is not None and (
        not isinstance(occurred_at, str)
        or not valid_import_timestamp(occurred_at)
    ):
        raise InvalidImport(f"line {line_number}: invalid occurred_at")
    if occurred_on is not None:
        if not isinstance(occurred_on, str):
            raise InvalidImport(f"line {line_number}: invalid occurred_on")
        try:
            parsed_date = date.fromisoformat(occurred_on)
        except ValueError:
            raise InvalidImport(f"line {line_number}: invalid occurred_on") from None
        if parsed_date.isoformat() != occurred_on:
            raise InvalidImport(f"line {line_number}: invalid occurred_on")
    reading_value = record.get("reading_value")
    reading_unit = record.get("reading_unit")
    if (reading_value is None) != (reading_unit is None):
        raise InvalidImport(f"line {line_number}: reading fields must be paired")
    if reading_value is not None:
        if not isinstance(reading_value, str) or not isinstance(reading_unit, str):
            raise InvalidImport(f"line {line_number}: invalid reading")
        try:
            parsed_reading = reading(reading_value + reading_unit)
        except argparse.ArgumentTypeError:
            raise InvalidImport(f"line {line_number}: invalid reading") from None
        if parsed_reading != (reading_value, reading_unit):
            raise InvalidImport(f"line {line_number}: reading must be canonical")
    event = {
        key: record[key]
        for key in ("id", "name", "occurred_at", "occurred_on", "note")
    }
    event["reading_value"] = reading_value
    event["reading_unit"] = reading_unit
    return event


def parse_correction_import_record(
    record: dict[str, Any], line_number: int
) -> dict[str, Any]:
    fields = {
        "record_version",
        "type",
        "id",
        "kind",
        "target_id",
        "replacement_id",
        "reason",
        "corrected_at",
    }
    if set(record) != fields:
        raise InvalidImport(f"line {line_number}: expected correction record fields")
    if (
        type(record["record_version"]) is not int
        or record["record_version"] not in (2, 3, 4, 5)
    ):
        raise InvalidImport(f"line {line_number}: unsupported record version")
    for field in ("id", "target_id", "reason"):
        value = record[field]
        if not isinstance(value, str) or not value:
            raise InvalidImport(
                f"line {line_number}: {field} must be a non-empty string"
            )
    kind = record["kind"]
    replacement_id = record["replacement_id"]
    if kind not in ("void", "replace"):
        raise InvalidImport(f"line {line_number}: invalid correction kind")
    if kind == "void" and replacement_id is not None:
        raise InvalidImport(f"line {line_number}: void cannot have a replacement")
    if kind == "replace" and (
        not isinstance(replacement_id, str) or not replacement_id
    ):
        raise InvalidImport(f"line {line_number}: replace requires a replacement")
    if replacement_id == record["target_id"]:
        raise InvalidImport(f"line {line_number}: correction must link distinct events")
    corrected_at = record["corrected_at"]
    if not isinstance(corrected_at, str) or not valid_import_timestamp(corrected_at):
        raise InvalidImport(f"line {line_number}: invalid corrected_at")
    text_values = (
        record["id"],
        record["target_id"],
        replacement_id or "",
        record["reason"],
    )
    try:
        for value in text_values:
            value.encode("utf-8")
    except UnicodeEncodeError:
        raise InvalidImport(f"line {line_number}: text must be valid UTF-8") from None
    if any(
        not character.isprintable()
        for value in text_values
        for character in value
    ):
        raise InvalidImport(f"line {line_number}: text must be printable")
    return correction_values(record)


def parse_activity_import_record(
    record: dict[str, Any], line_number: int
) -> dict[str, Any]:
    version = record.get("record_version")
    version_3_fields = {
        "record_version",
        "type",
        "name",
        "expected_interval_days",
    }
    version_4_fields = {*version_3_fields, "display_name"}
    if type(version) is not int or version not in (3, 4, 5):
        raise InvalidImport(f"line {line_number}: unsupported record version")
    if set(record) != (version_3_fields if version == 3 else version_4_fields):
        raise InvalidImport(f"line {line_number}: expected activity record fields")
    name = record["name"]
    if not isinstance(name, str) or not name:
        raise InvalidImport(f"line {line_number}: name must be a non-empty string")
    try:
        name.encode("utf-8")
    except UnicodeEncodeError:
        raise InvalidImport(f"line {line_number}: text must be valid UTF-8") from None
    if any(not character.isprintable() for character in name):
        raise InvalidImport(f"line {line_number}: text must be printable")
    interval = record["expected_interval_days"]
    if interval is not None and (
        type(interval) is not int
        or interval <= 0
        or interval > SQLITE_MAX_INTEGER
    ):
        raise InvalidImport(
            f"line {line_number}: expected_interval_days must be a positive integer"
        )
    display = record.get("display_name")
    if display is not None:
        if not isinstance(display, str) or not display:
            raise InvalidImport(
                f"line {line_number}: display_name must be a non-empty string or null"
            )
        try:
            display.encode("utf-8")
        except UnicodeEncodeError:
            raise InvalidImport(
                f"line {line_number}: text must be valid UTF-8"
            ) from None
        if any(not character.isprintable() for character in display):
            raise InvalidImport(f"line {line_number}: text must be printable")
    if version == 3 and interval is None:
        raise InvalidImport(
            f"line {line_number}: expected_interval_days must be a positive integer"
        )
    if interval is None and display is None:
        raise InvalidImport(f"line {line_number}: activity metadata is required")
    return {
        "name": name,
        "expected_interval_days": interval,
        "display_name": display,
    }


def parse_import_record(
    line: str, line_number: int, *, events_only: bool = False
) -> tuple[str, dict[str, Any]]:
    try:
        record = json.loads(line)
    except (ValueError, UnicodeError, RecursionError):
        raise InvalidImport(f"line {line_number}: invalid JSON") from None
    if not isinstance(record, dict):
        raise InvalidImport(f"line {line_number}: expected record object")
    record_type = record.get("type")
    if record_type == "event":
        return record_type, parse_event_import_record(record, line_number)
    if events_only:
        raise InvalidImport(f"line {line_number}: expected event record")
    if record_type == "correction":
        return record_type, parse_correction_import_record(record, line_number)
    if record_type == "activity":
        return record_type, parse_activity_import_record(record, line_number)
    raise InvalidImport(f"line {line_number}: unsupported record type")


def import_event_record(
    database: sqlite3.Connection, event: dict[str, Any], line_number: int
) -> None:
    existing = database.execute(
        """
        SELECT id, name, occurred_at, occurred_on, note,
               reading_value, reading_unit
        FROM events
        WHERE id = ?
        """,
        (event["id"],),
    ).fetchone()
    if existing is not None:
        if event_values(existing) != event:
            raise InvalidImport(
                f"line {line_number}: ID conflicts with existing event"
            )
        return
    database.execute(
        """
        INSERT INTO events
            (id, name, occurred_at, occurred_on, note,
             reading_value, reading_unit)
        VALUES (?, ?, ?, ?, ?, ?, ?)
        """,
        (
            event["id"],
            event["name"],
            event["occurred_at"],
            event["occurred_on"],
            event["note"],
            event["reading_value"],
            event["reading_unit"],
        ),
    )


def import_correction_record(
    database: sqlite3.Connection,
    correction: dict[str, Any],
    line_number: int,
) -> None:
    existing = database.execute(
        """
        SELECT id, kind, target_id, replacement_id, reason, corrected_at
        FROM corrections
        WHERE id = ?
        """,
        (correction["id"],),
    ).fetchone()
    if existing is not None:
        if correction_values(existing) != correction:
            raise InvalidImport(
                f"line {line_number}: ID conflicts with existing correction"
            )
        return
    linked_ids = (correction["target_id"], correction["replacement_id"])
    for linked_id in linked_ids:
        if linked_id is None:
            continue
        linked_event = database.execute(
            "SELECT 1 FROM events WHERE id = ?", (linked_id,)
        ).fetchone()
        if linked_event is None:
            raise InvalidImport(
                f"line {line_number}: correction references missing event"
            )
    corrected_target = database.execute(
        "SELECT 1 FROM corrections WHERE target_id = ?",
        (correction["target_id"],),
    ).fetchone()
    if corrected_target is not None:
        raise InvalidImport(f"line {line_number}: event already has a correction")
    replacement_id = correction["replacement_id"]
    if replacement_id is not None:
        used_replacement = database.execute(
            "SELECT 1 FROM corrections WHERE replacement_id = ?",
            (replacement_id,),
        ).fetchone()
        if used_replacement is not None:
            raise InvalidImport(
                f"line {line_number}: replacement event is already linked"
            )
    try:
        database.execute(
            """
            INSERT INTO corrections
                (id, kind, target_id, replacement_id, reason, corrected_at)
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                correction["id"],
                correction["kind"],
                correction["target_id"],
                replacement_id,
                correction["reason"],
                correction["corrected_at"],
            ),
        )
    except sqlite3.IntegrityError:
        raise InvalidImport(f"line {line_number}: invalid correction") from None


def import_activity_record(
    database: sqlite3.Connection,
    activity: dict[str, Any],
    line_number: int,
) -> None:
    existing = database.execute(
        """
        SELECT name, expected_interval_days, display_name
        FROM activities
        WHERE name = ?
        """,
        (activity["name"],),
    ).fetchone()
    if existing is not None:
        if activity_values(existing) != activity:
            raise InvalidImport(
                f"line {line_number}: name conflicts with existing activity"
            )
        return
    database.execute(
        """
        INSERT INTO activities (name, expected_interval_days, display_name)
        VALUES (?, ?, ?)
        """,
        (
            activity["name"],
            activity["expected_interval_days"],
            activity["display_name"],
        ),
    )


def import_records(database: sqlite3.Connection, *, events_only: bool) -> int:
    line_number = 0
    database.execute("BEGIN IMMEDIATE")
    try:
        for line_number, line in enumerate(sys.stdin, 1):
            record_type, record = parse_import_record(
                line, line_number, events_only=events_only
            )
            if record_type == "event":
                import_event_record(database, record, line_number)
            elif record_type == "correction":
                import_correction_record(database, record, line_number)
            else:
                import_activity_record(database, record, line_number)
        database.commit()
    except UnicodeError:
        database.rollback()
        raise InvalidImport(
            f"line {line_number + 1}: input must be valid UTF-8"
        ) from None
    except Exception:
        database.rollback()
        raise
    return 0


def batch_events(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    try:
        return import_records(database, events_only=True)
    except InvalidImport as error:
        raise InvalidBatch(str(error)) from None


def import_events(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    return import_records(database, events_only=False)


def stored_convention_issues(database: sqlite3.Connection) -> list[str]:
    issues: list[str] = []
    names = database.execute(
        """
        SELECT name FROM events
        UNION
        SELECT name FROM activities
        ORDER BY name COLLATE BINARY
        """
    )
    for row in names:
        name = row["name"]
        quoted_name = json.dumps(name, ensure_ascii=False)
        if any(not character.isprintable() for character in name):
            issues.append(f"control character in activity key: {quoted_name}")
        if not valid_activity_key(name):
            issues.append(f"invalid activity key: {quoted_name}")
        if unicodedata.normalize("NFC", name) != name:
            issues.append(f"non-NFC activity key: {quoted_name}")

    notes = database.execute(
        """
        SELECT id, note FROM events
        WHERE note IS NOT NULL
        ORDER BY rowid
        """
    )
    for row in notes:
        quoted_id = json.dumps(row["id"], ensure_ascii=False)
        if any(not character.isprintable() for character in row["note"]):
            issues.append(f"control character in note for event {quoted_id}")
        if unicodedata.normalize("NFC", row["note"]) != row["note"]:
            issues.append(f"non-NFC note for event {quoted_id}")

    displays = database.execute(
        """
        SELECT name, display_name FROM activities
        WHERE display_name IS NOT NULL
        ORDER BY name COLLATE BINARY
        """
    )
    for row in displays:
        quoted_name = json.dumps(row["name"], ensure_ascii=False)
        display = row["display_name"]
        if any(not character.isprintable() for character in display):
            issues.append(
                f"control character in display name for key {quoted_name}"
            )
        if unicodedata.normalize("NFC", display) != display:
            issues.append(f"non-NFC display name for key {quoted_name}")

    corrections = database.execute(
        """
        SELECT id, reason FROM corrections
        ORDER BY rowid
        """
    )
    for row in corrections:
        quoted_id = json.dumps(row["id"], ensure_ascii=False)
        reason = row["reason"]
        if any(not character.isprintable() for character in reason):
            issues.append(
                f"control character in correction reason for {quoted_id}"
            )
        if unicodedata.normalize("NFC", reason) != reason:
            issues.append(f"non-NFC correction reason for {quoted_id}")
    return issues


def doctor_database(path: Path, args: argparse.Namespace) -> int:
    resolved, database = connect_read_only(path)
    try:
        database.execute("BEGIN")
        version: int | None = None
        try:
            version = database_schema_version(database)
            if version != SCHEMA_VERSION:
                raise sqlite3.DatabaseError(
                    f"expected version {SCHEMA_VERSION}, found {version}"
                )
            validate_schema_structure(database)
            schema = "ok"
        except sqlite3.Error as error:
            schema = str(error)

        try:
            integrity_result = database.execute(
                "PRAGMA integrity_check(1)"
            ).fetchone()
            integrity = integrity_result[0] if integrity_result else "no result"
        except sqlite3.Error as error:
            integrity = str(error)

        if os.name == "posix":
            try:
                mode = stat.S_IMODE(resolved.stat().st_mode)
                permissions = (
                    "ok" if mode == 0o600 else f"expected 0600, found {mode:04o}"
                )
            except OSError as error:
                permissions = str(error)
        else:
            permissions = "not-applicable"

        events: int | None = 0
        corrections: int | None = 0
        activities: int | None = 0
        try:
            rows = database.execute(
                """
                SELECT id, name, occurred_at, occurred_on, note,
                       reading_value, reading_unit
                FROM events
                ORDER BY rowid
                """
            )
            for row in rows:
                events += 1
                encoded = json.dumps(interchange_record(row), ensure_ascii=False)
                parse_import_record(encoded, events)
            correction_rows = database.execute(
                """
                SELECT id, kind, target_id, replacement_id, reason, corrected_at
                FROM corrections
                ORDER BY rowid
                """
            )
            for row in correction_rows:
                corrections += 1
                encoded = json.dumps(
                    correction_interchange_record(row), ensure_ascii=False
                )
                parse_import_record(encoded, events + corrections)
            activity_rows = database.execute(
                """
                SELECT name, expected_interval_days, display_name
                FROM activities
                ORDER BY name COLLATE BINARY
                """
            )
            for row in activity_rows:
                activities += 1
                encoded = json.dumps(
                    activity_interchange_record(row), ensure_ascii=False
                )
                parse_import_record(encoded, events + corrections + activities)
            foreign_key_problem = database.execute(
                "PRAGMA foreign_key_check"
            ).fetchone()
            if foreign_key_problem is not None:
                raise sqlite3.DatabaseError("foreign key check failed")
            parseability = "ok"
        except (InvalidImport, sqlite3.Error, TypeError, UnicodeError) as error:
            events = None
            corrections = None
            activities = None
            parseability = str(error)

        convention_issues: list[str] | None
        try:
            convention_issues = stored_convention_issues(database)
            conventions = "problems" if convention_issues else "ok"
        except (sqlite3.Error, TypeError, UnicodeError) as error:
            convention_issues = None
            conventions = str(error)

        database.commit()
        checks = (schema, integrity, permissions, parseability, conventions)
        status = (
            "ok"
            if all(check in ("ok", "not-applicable") for check in checks)
            else "problems"
        )
        report = {
            "schema_version": 2,
            "type": "doctor",
            "database": str(resolved),
            "database_schema_version": version,
            "schema": schema,
            "integrity": integrity,
            "permissions": permissions,
            "parseability": parseability,
            "conventions": conventions,
            "convention_issues": convention_issues,
            "events": events,
            "corrections": corrections,
            "activities": activities,
            "status": status,
        }
        if args.jsonl:
            emit_json(report)
        else:
            print(f"Database: {report['database']}")
            print(f"Schema: {schema}")
            print(f"Integrity: {integrity}")
            print(f"Permissions: {permissions}")
            print(f"Parseability: {parseability}")
            print(f"Conventions: {conventions}")
            for issue in convention_issues or ():
                print(f"Convention issue: {issue}")
            print(f"Events: {events if events is not None else '-'}")
            print(
                "Corrections: "
                f"{corrections if corrections is not None else '-'}"
            )
            print(
                f"Activities: {activities if activities is not None else '-'}"
            )
            print(f"Status: {status}")
        return 0 if status == "ok" else 3
    finally:
        database.close()


def silence_broken_pipe() -> None:
    try:
        stdout = sys.stdout.fileno()
        devnull = os.open(os.devnull, os.O_WRONLY)
        try:
            os.dup2(devnull, stdout)
        finally:
            os.close(devnull)
    except (AttributeError, OSError, ValueError):
        pass


def storage_error_message(error: OSError | sqlite3.Error) -> str:
    message = str(error)
    if isinstance(error, sqlite3.OperationalError) and any(
        state in message.lower() for state in ("busy", "locked")
    ):
        return (
            f"database is busy after {BUSY_TIMEOUT_SECONDS:g} seconds; "
            "retry the command"
        )
    return message


def run(
    argv: Sequence[str] | None = None,
    *,
    now: datetime | None = None,
    path: Path | None = None,
) -> int:
    if now is None:
        now = datetime.now().astimezone()
    args = parse_args(argv, today=now.date())
    args.now = now
    if path is None:
        path = args.database if args.database is not None else database_path()
    if args.command == "doctor":
        return args.handler(path, args)
    database = connect_database(path)
    try:
        return args.handler(database, args)
    finally:
        database.close()


def main(argv: Sequence[str] | None = None) -> int:
    try:
        return run(argv)
    except BrokenPipeError:
        silence_broken_pipe()
        return 0
    except ActivityNotFound as error:
        print(f"lastdone: activity not found: {error}", file=sys.stderr)
        return 1
    except EventNotFound as error:
        print(f"lastdone: event not found: {error}", file=sys.stderr)
        return 1
    except EventAlreadyCorrected as error:
        print(f"lastdone: event already corrected: {error}", file=sys.stderr)
        return 1
    except InvalidCorrection as error:
        print(f"lastdone: error: {error}", file=sys.stderr)
        return 2
    except InvalidActivityUpdate as error:
        print(f"lastdone: error: {error}", file=sys.stderr)
        return 2
    except InvalidReading as error:
        print(f"lastdone: error: {error}", file=sys.stderr)
        return 2
    except InvalidBatch as error:
        print(f"lastdone: batch error: {error}", file=sys.stderr)
        return 2
    except InvalidImport as error:
        print(f"lastdone: import error: {error}", file=sys.stderr)
        return 2
    except (OSError, sqlite3.Error) as error:
        print(
            f"lastdone: storage error: {storage_error_message(error)}",
            file=sys.stderr,
        )
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
