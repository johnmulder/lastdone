#!/usr/bin/env python3
"""Record and query the last time an activity happened."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import sqlite3
import sys
from datetime import date, datetime, timezone
from typing import Any, Sequence
from uuid import uuid4


VERSION = "0.2.0"


class ActivityNotFound(Exception):
    """Raised when a requested activity has no events."""


class ArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.exit(2, f"lastdone: error: {message}\n")


def activity_name(value: str) -> str:
    if not value or not value.isprintable():
        raise argparse.ArgumentTypeError("NAME must be non-empty printable text")
    return value


def calendar_date(value: str) -> str:
    try:
        parsed = date.fromisoformat(value)
    except ValueError:
        raise argparse.ArgumentTypeError("DATE must be YYYY-MM-DD") from None
    if parsed.isoformat() != value:
        raise argparse.ArgumentTypeError("DATE must be YYYY-MM-DD")
    if parsed > datetime.now().astimezone().date():
        raise argparse.ArgumentTypeError("DATE must not be in the future")
    return value


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = ArgumentParser(
        prog="lastdone",
        description="Record and query recurring real-world activities.",
    )
    parser.add_argument(
        "--version", action="version", version=f"lastdone {VERSION}"
    )
    commands = parser.add_subparsers(dest="command", required=True)

    add = commands.add_parser("add", help="record an activity")
    add.add_argument("name", type=activity_name, metavar="NAME")
    add.add_argument("--date", type=calendar_date, dest="occurred_on", metavar="DATE")
    add.add_argument("--jsonl", action="store_true", help="emit JSONL")
    add.set_defaults(handler=add_event)

    show = commands.add_parser("show", help="show an activity summary")
    show.add_argument("name", type=activity_name, metavar="NAME")
    show.add_argument("--jsonl", action="store_true", help="emit JSONL")
    show.set_defaults(handler=show_activity)

    history = commands.add_parser("history", help="show full activity history")
    history.add_argument("name", type=activity_name, metavar="NAME")
    history.add_argument("--jsonl", action="store_true", help="emit JSONL")
    history.set_defaults(handler=show_history)

    list_command = commands.add_parser("list", help="list known activities")
    list_command.add_argument("--jsonl", action="store_true", help="emit JSONL")
    list_command.set_defaults(handler=list_activities)

    return parser.parse_args(argv)


def database_path() -> Path:
    data_home = os.environ.get("XDG_DATA_HOME")
    root = Path(data_home).expanduser() if data_home else Path.home() / ".local/share"
    return root / "last" / "last.db"


def create_events_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE events (
            id TEXT PRIMARY KEY,
            name TEXT NOT NULL,
            occurred_at TEXT,
            occurred_on TEXT,
            note TEXT,
            CHECK ((occurred_at IS NOT NULL) <> (occurred_on IS NOT NULL))
        )
        """
    )


def initialize_schema(database: sqlite3.Connection) -> None:
    columns = {
        row["name"] for row in database.execute("PRAGMA table_info(events)")
    }
    if not columns:
        create_events_table(database)
    elif "occurred_on" not in columns:
        database.execute("BEGIN")
        try:
            database.execute("ALTER TABLE events RENAME TO events_legacy")
            create_events_table(database)
            database.execute(
                """
                INSERT INTO events (id, name, occurred_at, occurred_on, note)
                SELECT id, name, occurred_at, NULL, note
                FROM events_legacy
                """
            )
            database.execute("DROP TABLE events_legacy")
            database.commit()
        except Exception:
            database.rollback()
            raise
    database.execute(
        "CREATE INDEX IF NOT EXISTS idx_events_name ON events(name)"
    )
    database.commit()


def connect_database() -> sqlite3.Connection:
    path = database_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    database = sqlite3.connect(path)
    database.row_factory = sqlite3.Row
    try:
        initialize_schema(database)
    except Exception:
        database.close()
        raise
    return database


def current_timestamp() -> str:
    return (
        datetime.now(timezone.utc)
        .isoformat(timespec="microseconds")
        .replace("+00:00", "Z")
    )


def event_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {
        "schema_version": 2,
        "type": "event",
        "id": row["id"],
        "name": row["name"],
        "occurred_at": row["occurred_at"],
        "occurred_on": row["occurred_on"],
        "note": row["note"],
    }


def emit_json(record: dict[str, Any]) -> None:
    print(json.dumps(record, ensure_ascii=False, separators=(",", ":")))


def rows_for_activity(
    database: sqlite3.Connection, name: str
) -> list[sqlite3.Row]:
    rows = database.execute(
        """
        SELECT rowid AS insertion_order, id, name, occurred_at, occurred_on, note
        FROM events
        WHERE name = ?
        """,
        (name,),
    ).fetchall()
    return sorted(rows, key=occurrence_sort_key, reverse=True)


def local_date(timestamp: str) -> date:
    return datetime.fromisoformat(timestamp.replace("Z", "+00:00")).astimezone().date()


def occurrence_date(row: sqlite3.Row | dict[str, Any]) -> date:
    if row["occurred_on"] is not None:
        return date.fromisoformat(row["occurred_on"])
    return local_date(row["occurred_at"])


def occurrence_sort_key(row: sqlite3.Row) -> tuple[date, bool, str, int]:
    return (
        occurrence_date(row),
        row["occurred_at"] is not None,
        row["occurred_at"] or "",
        row["insertion_order"],
    )


def occurrence_record(row: sqlite3.Row) -> dict[str, str | None]:
    return {"occurred_at": row["occurred_at"], "occurred_on": row["occurred_on"]}


def add_event(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    event = {
        "id": str(uuid4()),
        "name": args.name,
        "occurred_at": None if args.occurred_on else current_timestamp(),
        "occurred_on": args.occurred_on,
        "note": None,
    }
    database.execute(
        """
        INSERT INTO events (id, name, occurred_at, occurred_on, note)
        VALUES (?, ?, ?, ?, ?)
        """,
        (
            event["id"],
            event["name"],
            event["occurred_at"],
            event["occurred_on"],
            event["note"],
        ),
    )
    database.commit()
    if args.jsonl:
        emit_json(event_record(event))
    return 0


def show_activity(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = rows_for_activity(database, args.name)
    if not rows:
        raise ActivityNotFound(args.name)

    latest = rows[0]
    previous = rows[1] if len(rows) > 1 else None
    interval = (
        (occurrence_date(latest) - occurrence_date(previous)).days
        if previous
        else None
    )
    if args.jsonl:
        emit_json(
            {
                "schema_version": 2,
                "type": "summary",
                "name": args.name,
                "last": occurrence_record(latest),
                "previous": occurrence_record(previous) if previous else None,
                "interval_days": interval,
                "occurrences": len(rows),
            }
        )
        return 0

    print(args.name)
    print(f"Last: {occurrence_date(latest).isoformat()}")
    print(
        f"Previous: {occurrence_date(previous).isoformat()}"
        if previous
        else "Previous: -"
    )
    print(f"Interval: {interval} days" if interval is not None else "Interval: -")
    print(f"Occurrences: {len(rows)}")
    return 0


def show_history(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = rows_for_activity(database, args.name)
    if not rows:
        raise ActivityNotFound(args.name)
    for row in rows:
        if args.jsonl:
            emit_json(event_record(row))
        else:
            print(occurrence_date(row).isoformat())
    return 0


def list_activities(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = database.execute(
        "SELECT DISTINCT name FROM events ORDER BY name COLLATE BINARY"
    ).fetchall()
    for row in rows:
        if args.jsonl:
            emit_json(
                {"schema_version": 2, "type": "activity", "name": row["name"]}
            )
        else:
            print(row["name"])
    return 0


def silence_broken_pipe() -> None:
    try:
        stdout = sys.stdout.fileno()
        devnull = os.open(os.devnull, os.O_WRONLY)
        try:
            os.dup2(devnull, stdout)
        finally:
            os.close(devnull)
    except (AttributeError, OSError, ValueError):
        pass


def run(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv)
    database = connect_database()
    try:
        return args.handler(database, args)
    finally:
        database.close()


def main(argv: Sequence[str] | None = None) -> int:
    try:
        return run(argv)
    except BrokenPipeError:
        silence_broken_pipe()
        return 0
    except ActivityNotFound as error:
        print(f"lastdone: activity not found: {error}", file=sys.stderr)
        return 1
    except (OSError, sqlite3.Error) as error:
        print(f"lastdone: storage error: {error}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
