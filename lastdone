VERSION = "0.7.0"
SCHEMA_VERSION = 4
BUSY_TIMEOUT_SECONDS = 5.0
SQLITE_MAX_INTEGER = 2**63 - 1


class ActivityNotFound(Exception):
    """Raised when a requested activity has no events."""


class EventNotFound(Exception):
    """Raised when a requested event does not exist."""


class EventAlreadyCorrected(Exception):
    """Raised when a requested event already has a correction."""


class InvalidCorrection(Exception):
    """Raised when a correction request is incomplete."""


class InvalidImport(Exception):
    """Raised when an interchange record cannot be imported."""


class ArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.exit(2, f"lastdone: error: {message}\n")


def activity_name(value: str) -> str:
    if not value or not value.isprintable():
        raise argparse.ArgumentTypeError("NAME must be non-empty printable text")
    return value


def event_id(value: str) -> str:
    if not value or not value.isprintable():
        raise argparse.ArgumentTypeError("EVENT_ID must be non-empty printable text")
    return value


def correction_reason(value: str) -> str:
    if not value or not value.isprintable():
        raise argparse.ArgumentTypeError("TEXT must be non-empty printable text")
    return value


def replacement_note(value: str) -> str:
    if any(not character.isprintable() for character in value):
        raise argparse.ArgumentTypeError("TEXT must be printable text")
    return value


def expanded_path(value: str) -> Path:
    try:
        return Path(value).expanduser()
    except RuntimeError as error:
        raise OSError(str(error)) from error


def database_file(value: str) -> Path:
    if not value:
        raise argparse.ArgumentTypeError("PATH must be non-empty")
    try:
        return expanded_path(value)
    except OSError:
        raise argparse.ArgumentTypeError("PATH contains an unknown home") from None


def calendar_date(value: str, *, today: date) -> str:
    try:
        parsed = date.fromisoformat(value)
    except ValueError:
        raise argparse.ArgumentTypeError("DATE must be YYYY-MM-DD") from None
    if parsed.isoformat() != value:
        raise argparse.ArgumentTypeError("DATE must be YYYY-MM-DD")
    if parsed > today:
        raise argparse.ArgumentTypeError("DATE must not be in the future")
    return value


def day_interval(value: str) -> int:
    digits = value[:-1]
    if (
        not value.endswith("d")
        or not digits
        or not digits.isascii()
        or not digits.isdigit()
        or digits.startswith("0")
    ):
        raise argparse.ArgumentTypeError("INTERVAL must be a positive whole-day value")
    interval = int(digits)
    if interval > SQLITE_MAX_INTEGER:
        raise argparse.ArgumentTypeError("INTERVAL is too large")
    return interval


def parse_args(
    argv: Sequence[str] | None = None, *, today: date | None = None
) -> argparse.Namespace:
    if today is None:
        today = datetime.now().astimezone().date()
    parser = ArgumentParser(
        prog="lastdone",
        description="Record and query recurring real-world activities.",
    )
    parser.add_argument(
        "--version", action="version", version=f"lastdone {VERSION}"
    )
    parser.add_argument(
        "--db",
        type=database_file,
        dest="database",
        metavar="PATH",
        help="use PATH as the database",
    )
    commands = parser.add_subparsers(dest="command", required=True)

    add = commands.add_parser("add", help="record an activity")
    add.add_argument("name", type=activity_name, metavar="NAME")
    add.add_argument(
        "--date",
        type=partial(calendar_date, today=today),
        dest="occurred_on",
        metavar="DATE",
    )
    add.add_argument("--jsonl", action="store_true", help="emit JSONL")
    add.set_defaults(handler=add_event)

    show = commands.add_parser("show", help="show an activity summary")
    show.add_argument("name", type=activity_name, metavar="NAME")
    show.add_argument("--jsonl", action="store_true", help="emit JSONL")
    show.set_defaults(handler=show_activity)

    history = commands.add_parser("history", help="show full activity history")
    history.add_argument("name", type=activity_name, metavar="NAME")
    history.add_argument(
        "--include-corrections",
        action="store_true",
        help="include corrected events and correction records",
    )
    history.add_argument("--jsonl", action="store_true", help="emit JSONL")
    history.set_defaults(handler=show_history)

    void = commands.add_parser("void", help="void an event")
    void.add_argument("event_id", type=event_id, metavar="EVENT_ID")
    void.add_argument(
        "--reason",
        type=correction_reason,
        required=True,
        metavar="TEXT",
    )
    void.add_argument("--jsonl", action="store_true", help="emit JSONL")
    void.set_defaults(handler=void_event)

    replace = commands.add_parser("replace", help="replace an event")
    replace.add_argument("event_id", type=event_id, metavar="EVENT_ID")
    replace.add_argument(
        "--reason",
        type=correction_reason,
        required=True,
        metavar="TEXT",
    )
    replace.add_argument(
        "--name",
        type=activity_name,
        default=argparse.SUPPRESS,
        metavar="NAME",
    )
    replace.add_argument(
        "--date",
        type=partial(calendar_date, today=today),
        dest="occurred_on",
        default=argparse.SUPPRESS,
        metavar="DATE",
    )
    replace.add_argument(
        "--note",
        type=replacement_note,
        default=argparse.SUPPRESS,
        metavar="TEXT",
    )
    replace.add_argument("--jsonl", action="store_true", help="emit JSONL")
    replace.set_defaults(handler=replace_event)

    set_command = commands.add_parser("set", help="set an expected interval")
    set_command.add_argument("name", type=activity_name, metavar="NAME")
    set_command.add_argument(
        "--every",
        type=day_interval,
        dest="expected_interval_days",
        required=True,
        metavar="INTERVAL",
    )
    set_command.add_argument("--jsonl", action="store_true", help="emit JSONL")
    set_command.set_defaults(handler=set_interval)

    due_command = commands.add_parser("due", help="show configured due states")
    due_command.add_argument(
        "--overdue", action="store_true", help="show only overdue activities"
    )
    due_command.add_argument("--jsonl", action="store_true", help="emit JSONL")
    due_command.set_defaults(handler=show_due)

    list_command = commands.add_parser("list", help="list known activities")
    list_command.add_argument("--jsonl", action="store_true", help="emit JSONL")
    list_command.set_defaults(handler=list_activities)

    export_command = commands.add_parser("export", help="export all records")
    export_command.add_argument("--jsonl", action="store_true", required=True)
    export_command.set_defaults(handler=export_events)

    import_command = commands.add_parser("import", help="import records")
    import_command.add_argument("--jsonl", action="store_true", required=True)
    import_command.set_defaults(handler=import_events)

    doctor_command = commands.add_parser("doctor", help="check the database")
    doctor_command.add_argument("--jsonl", action="store_true", help="emit JSONL")
    doctor_command.set_defaults(handler=doctor_database)

    return parser.parse_args(argv)


def database_path() -> Path:
    configured = os.environ.get("LASTDONE_DB")
    if configured:
        return expanded_path(configured)
    data_home = os.environ.get("XDG_DATA_HOME")
    root = expanded_path(data_home) if data_home else Path.home() / ".local/share"
    return root / "last" / "last.db"


def create_events_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE events (
            id TEXT NOT NULL PRIMARY KEY
                CONSTRAINT events_id_nonempty CHECK (length(id) > 0),
            name TEXT NOT NULL
                CONSTRAINT events_name_nonempty CHECK (length(name) > 0),
            occurred_at TEXT,
            occurred_on TEXT,
            note TEXT,
            CONSTRAINT events_occurrence_exactly_one CHECK (
                (occurred_at IS NOT NULL) <> (occurred_on IS NOT NULL)
            ),
            CONSTRAINT events_occurred_at_valid CHECK (
                occurred_at IS NULL OR (
                    length(occurred_at) = 27
                    AND occurred_at GLOB (
                        '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T' ||
                        '[0-9][0-9]:[0-9][0-9]:[0-9][0-9].' ||
                        '[0-9][0-9][0-9][0-9][0-9][0-9]Z'
                    )
                    AND coalesce(
                        datetime(substr(occurred_at, 1, 19), '+0 seconds') =
                            replace(substr(occurred_at, 1, 19), 'T', ' '),
                        0
                    )
                )
            ),
            CONSTRAINT events_occurred_on_valid CHECK (
                occurred_on IS NULL OR (
                    length(occurred_on) = 10
                    AND occurred_on GLOB
                        '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
                    AND coalesce(
                        date(occurred_on, '+0 days') = occurred_on,
                        0
                    )
                )
            )
        )
        """
    )


def create_corrections_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE corrections (
            id TEXT NOT NULL PRIMARY KEY
                CONSTRAINT corrections_id_nonempty CHECK (length(id) > 0),
            kind TEXT NOT NULL
                CONSTRAINT corrections_kind_valid
                CHECK (kind IN ('void', 'replace')),
            target_id TEXT NOT NULL
                CONSTRAINT corrections_target_unique UNIQUE
                REFERENCES events(id),
            replacement_id TEXT
                CONSTRAINT corrections_replacement_unique UNIQUE
                REFERENCES events(id),
            reason TEXT NOT NULL
                CONSTRAINT corrections_reason_nonempty CHECK (length(reason) > 0),
            corrected_at TEXT NOT NULL
                CONSTRAINT corrections_corrected_at_valid CHECK (
                    length(corrected_at) = 27
                    AND corrected_at GLOB (
                        '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T' ||
                        '[0-9][0-9]:[0-9][0-9]:[0-9][0-9].' ||
                        '[0-9][0-9][0-9][0-9][0-9][0-9]Z'
                    )
                    AND coalesce(
                        datetime(substr(corrected_at, 1, 19), '+0 seconds') =
                            replace(substr(corrected_at, 1, 19), 'T', ' '),
                        0
                    )
                ),
            CONSTRAINT corrections_relationship_valid CHECK (
                (kind = 'void' AND replacement_id IS NULL)
                OR (kind = 'replace' AND replacement_id IS NOT NULL)
            ),
            CONSTRAINT corrections_distinct_events CHECK (
                replacement_id IS NULL OR target_id <> replacement_id
            )
        )
        """
    )


def create_version_3_activities_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE activities (
            name TEXT NOT NULL PRIMARY KEY
                CONSTRAINT activities_name_nonempty CHECK (length(name) > 0),
            expected_interval_days INTEGER NOT NULL
                CONSTRAINT activities_interval_positive CHECK (
                    typeof(expected_interval_days) = 'integer'
                    AND expected_interval_days > 0
                )
        )
        """
    )


def create_activities_table(database: sqlite3.Connection) -> None:
    database.execute(
        """
        CREATE TABLE activities (
            name TEXT NOT NULL PRIMARY KEY
                CONSTRAINT activities_name_nonempty CHECK (length(name) > 0),
            expected_interval_days INTEGER
                CONSTRAINT activities_interval_positive CHECK (
                    expected_interval_days IS NULL OR (
                        typeof(expected_interval_days) = 'integer'
                        AND expected_interval_days > 0
                    )
                ),
            display_name TEXT
                CONSTRAINT activities_display_name_nonempty CHECK (
                    display_name IS NULL OR length(display_name) > 0
                ),
            CONSTRAINT activities_metadata_present CHECK (
                expected_interval_days IS NOT NULL OR display_name IS NOT NULL
            )
        )
        """
    )


def table_columns(database: sqlite3.Connection) -> tuple[str, ...]:
    return tuple(row["name"] for row in database.execute("PRAGMA table_info(events)"))


def correction_columns(database: sqlite3.Connection) -> tuple[str, ...]:
    return tuple(
        row["name"] for row in database.execute("PRAGMA table_info(corrections)")
    )


def activity_columns(database: sqlite3.Connection) -> tuple[str, ...]:
    return tuple(
        row["name"] for row in database.execute("PRAGMA table_info(activities)")
    )


def migrate_to_version_1(database: sqlite3.Connection) -> None:
    columns = table_columns(database)
    if not columns:
        create_events_table(database)
    else:
        legacy_columns = ("id", "name", "occurred_at", "note")
        precision_columns = ("id", "name", "occurred_at", "occurred_on", "note")
        if columns not in (legacy_columns, precision_columns):
            raise sqlite3.DatabaseError("unrecognized unversioned events schema")
        database.execute("ALTER TABLE events RENAME TO events_legacy")
        create_events_table(database)
        if columns == legacy_columns:
            database.execute(
                """
                INSERT INTO events (id, name, occurred_at, occurred_on, note)
                SELECT id, name, occurred_at, NULL, note
                FROM events_legacy
                """
            )
        else:
            database.execute(
                """
                INSERT INTO events (id, name, occurred_at, occurred_on, note)
                SELECT id, name, occurred_at, occurred_on, note
                FROM events_legacy
                """
            )
        database.execute("DROP TABLE events_legacy")
    database.execute("CREATE INDEX idx_events_name ON events(name)")


def migrate_to_version_2(database: sqlite3.Connection) -> None:
    create_corrections_table(database)


def migrate_to_version_3(database: sqlite3.Connection) -> None:
    create_version_3_activities_table(database)


def migrate_to_version_4(database: sqlite3.Connection) -> None:
    database.execute("ALTER TABLE activities RENAME TO activities_legacy")
    create_activities_table(database)
    database.execute(
        """
        INSERT INTO activities
            (name, expected_interval_days, display_name)
        SELECT name, expected_interval_days, NULL
        FROM activities_legacy
        """
    )
    database.execute("DROP TABLE activities_legacy")


MIGRATIONS = (
    migrate_to_version_1,
    migrate_to_version_2,
    migrate_to_version_3,
    migrate_to_version_4,
)


def database_schema_version(database: sqlite3.Connection) -> int:
    return database.execute("PRAGMA user_version").fetchone()[0]


def backup_before_migration(
    database: sqlite3.Connection, path: Path, source_version: int
) -> None:
    if source_version == 0 and not table_columns(database):
        return
    backup_path = path.with_name(f"{path.name}.v{source_version}.bak")
    if backup_path.exists():
        return
    backup = sqlite3.connect(backup_path)
    try:
        database.backup(backup)
    except Exception:
        backup.close()
        try:
            backup_path.unlink()
        except OSError:
            pass
        raise
    backup.close()
    if os.name == "posix":
        os.chmod(backup_path, 0o600)


def validate_schema_structure(database: sqlite3.Connection) -> None:
    expected_columns = ("id", "name", "occurred_at", "occurred_on", "note")
    if table_columns(database) != expected_columns:
        raise sqlite3.DatabaseError("database schema does not match its version")
    table_sql_row = database.execute(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'events'"
    ).fetchone()
    table_sql = table_sql_row["sql"] if table_sql_row else ""
    markers = (
        "events_id_nonempty",
        "events_name_nonempty",
        "events_occurrence_exactly_one",
        "events_occurred_at_valid",
        "events_occurred_on_valid",
    )
    if any(marker not in table_sql for marker in markers):
        raise sqlite3.DatabaseError("database schema does not match its version")
    indexes = {
        row["name"] for row in database.execute("PRAGMA index_list(events)")
    }
    if "idx_events_name" not in indexes:
        raise sqlite3.DatabaseError("database schema does not match its version")
    expected_correction_columns = (
        "id",
        "kind",
        "target_id",
        "replacement_id",
        "reason",
        "corrected_at",
    )
    if correction_columns(database) != expected_correction_columns:
        raise sqlite3.DatabaseError("database schema does not match its version")
    correction_sql_row = database.execute(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'corrections'"
    ).fetchone()
    correction_sql = correction_sql_row["sql"] if correction_sql_row else ""
    correction_markers = (
        "corrections_id_nonempty",
        "corrections_kind_valid",
        "corrections_target_unique",
        "corrections_replacement_unique",
        "corrections_reason_nonempty",
        "corrections_corrected_at_valid",
        "corrections_relationship_valid",
        "corrections_distinct_events",
    )
    if any(marker not in correction_sql for marker in correction_markers):
        raise sqlite3.DatabaseError("database schema does not match its version")
    if activity_columns(database) != (
        "name",
        "expected_interval_days",
        "display_name",
    ):
        raise sqlite3.DatabaseError("database schema does not match its version")
    activity_sql_row = database.execute(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = 'activities'"
    ).fetchone()
    activity_sql = activity_sql_row["sql"] if activity_sql_row else ""
    activity_markers = (
        "activities_name_nonempty",
        "activities_interval_positive",
        "activities_display_name_nonempty",
        "activities_metadata_present",
    )
    if any(marker not in activity_sql for marker in activity_markers):
        raise sqlite3.DatabaseError("database schema does not match its version")


def validate_schema(database: sqlite3.Connection) -> None:
    validate_schema_structure(database)
    integrity = database.execute("PRAGMA integrity_check(1)").fetchone()[0]
    if integrity != "ok":
        raise sqlite3.DatabaseError(f"database integrity check failed: {integrity}")
    foreign_key_problem = database.execute("PRAGMA foreign_key_check").fetchone()
    if foreign_key_problem is not None:
        raise sqlite3.DatabaseError("database foreign key check failed")


def apply_migrations(database: sqlite3.Connection, path: Path) -> None:
    version = database_schema_version(database)
    if version > SCHEMA_VERSION:
        raise sqlite3.DatabaseError(
            f"database schema version {version} is newer than supported version "
            f"{SCHEMA_VERSION}"
        )
    if version in (0, 3):
        backup_before_migration(database, path, version)
    while version < SCHEMA_VERSION:
        database.execute("BEGIN IMMEDIATE")
        try:
            version = database_schema_version(database)
            if version > SCHEMA_VERSION:
                raise sqlite3.DatabaseError(
                    f"database schema version {version} is newer than supported "
                    f"version {SCHEMA_VERSION}"
                )
            if version == SCHEMA_VERSION:
                database.commit()
                break
            target_version = version + 1
            MIGRATIONS[target_version - 1](database)
            database.execute(f"PRAGMA user_version = {target_version}")
            database.commit()
            version = target_version
        except Exception:
            database.rollback()
            raise
    validate_schema(database)


def prepare_storage(path: Path) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)


def connect_database(path: Path) -> sqlite3.Connection:
    prepare_storage(path)
    database = sqlite3.connect(path, timeout=BUSY_TIMEOUT_SECONDS)
    database.row_factory = sqlite3.Row
    database.execute("PRAGMA foreign_keys = ON")
    try:
        apply_migrations(database, path)
        if os.name == "posix":
            os.chmod(path, 0o600)
    except Exception:
        database.close()
        raise
    return database


def connect_read_only(path: Path) -> tuple[Path, sqlite3.Connection]:
    resolved = path.resolve()
    database = sqlite3.connect(
        f"{resolved.as_uri()}?mode=ro",
        uri=True,
        timeout=BUSY_TIMEOUT_SECONDS,
    )
    database.row_factory = sqlite3.Row
    database.execute("PRAGMA foreign_keys = ON")
    return resolved, database


def current_timestamp(now: datetime) -> str:
    return (
        now.astimezone(timezone.utc)
        .isoformat(timespec="microseconds")
        .replace("+00:00", "Z")
    )


def event_values(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {
        "id": row["id"],
        "name": row["name"],
        "occurred_at": row["occurred_at"],
        "occurred_on": row["occurred_on"],
        "note": row["note"],
    }


def event_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {"schema_version": 2, "type": "event", **event_values(row)}


def correction_values(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {
        "id": row["id"],
        "kind": row["kind"],
        "target_id": row["target_id"],
        "replacement_id": row["replacement_id"],
        "reason": row["reason"],
        "corrected_at": row["corrected_at"],
    }


def correction_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {"schema_version": 2, "type": "correction", **correction_values(row)}


def activity_values(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {
        "name": row["name"],
        "expected_interval_days": row["expected_interval_days"],
    }


def activity_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {"schema_version": 2, "type": "activity", **activity_values(row)}


def interchange_record(row: sqlite3.Row | dict[str, Any]) -> dict[str, Any]:
    return {"record_version": 3, "type": "event", **event_values(row)}


def correction_interchange_record(
    row: sqlite3.Row | dict[str, Any],
) -> dict[str, Any]:
    return {"record_version": 3, "type": "correction", **correction_values(row)}


def activity_interchange_record(
    row: sqlite3.Row | dict[str, Any],
) -> dict[str, Any]:
    return {"record_version": 3, "type": "activity", **activity_values(row)}


def emit_json(record: dict[str, Any]) -> None:
    print(json.dumps(record, ensure_ascii=False, separators=(",", ":")))


def rows_for_activity(
    database: sqlite3.Connection, name: str
) -> list[sqlite3.Row]:
    rows = database.execute(
        """
        SELECT rowid AS insertion_order, id, name, occurred_at, occurred_on, note
        FROM events
        WHERE name = ?
          AND NOT EXISTS (
              SELECT 1 FROM corrections WHERE target_id = events.id
          )
        """,
        (name,),
    ).fetchall()
    return sorted(rows, key=occurrence_sort_key, reverse=True)


def local_date(timestamp: str) -> date:
    return datetime.fromisoformat(timestamp.replace("Z", "+00:00")).astimezone().date()


def occurrence_date(row: sqlite3.Row | dict[str, Any]) -> date:
    if row["occurred_on"] is not None:
        return date.fromisoformat(row["occurred_on"])
    return local_date(row["occurred_at"])


def occurrence_sort_key(row: sqlite3.Row) -> tuple[date, bool, str, int]:
    return (
        occurrence_date(row),
        row["occurred_at"] is not None,
        row["occurred_at"] or "",
        row["insertion_order"],
    )


def occurrence_record(row: sqlite3.Row) -> dict[str, str | None]:
    return {"occurred_at": row["occurred_at"], "occurred_on": row["occurred_on"]}


def add_event(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    event = {
        "id": str(uuid4()),
        "name": args.name,
        "occurred_at": None if args.occurred_on else current_timestamp(args.now),
        "occurred_on": args.occurred_on,
        "note": None,
    }
    database.execute(
        """
        INSERT INTO events (id, name, occurred_at, occurred_on, note)
        VALUES (?, ?, ?, ?, ?)
        """,
        (
            event["id"],
            event["name"],
            event["occurred_at"],
            event["occurred_on"],
            event["note"],
        ),
    )
    database.commit()
    if args.jsonl:
        emit_json(event_record(event))
    return 0


def uncorrected_event(
    database: sqlite3.Connection, requested_id: str
) -> sqlite3.Row:
    event = database.execute(
        """
        SELECT id, name, occurred_at, occurred_on, note
        FROM events
        WHERE id = ?
        """,
        (requested_id,),
    ).fetchone()
    if event is None:
        raise EventNotFound(requested_id)
    correction = database.execute(
        "SELECT 1 FROM corrections WHERE target_id = ?",
        (requested_id,),
    ).fetchone()
    if correction is not None:
        raise EventAlreadyCorrected(requested_id)
    return event


def store_correction(
    database: sqlite3.Connection,
    *,
    kind: str,
    target_id: str,
    replacement_id: str | None,
    reason: str,
    now: datetime,
) -> dict[str, Any]:
    correction = {
        "id": str(uuid4()),
        "kind": kind,
        "target_id": target_id,
        "replacement_id": replacement_id,
        "reason": reason,
        "corrected_at": current_timestamp(now),
    }
    database.execute(
        """
        INSERT INTO corrections
            (id, kind, target_id, replacement_id, reason, corrected_at)
        VALUES (?, ?, ?, ?, ?, ?)
        """,
        tuple(correction.values()),
    )
    return correction


def void_event(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    database.execute("BEGIN IMMEDIATE")
    try:
        uncorrected_event(database, args.event_id)
        correction = store_correction(
            database,
            kind="void",
            target_id=args.event_id,
            replacement_id=None,
            reason=args.reason,
            now=args.now,
        )
        database.commit()
    except Exception:
        database.rollback()
        raise
    if args.jsonl:
        emit_json(correction_record(correction))
    return 0


def replace_event(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    changed_fields = ("name", "occurred_on", "note")
    if not any(hasattr(args, field) for field in changed_fields):
        raise InvalidCorrection(
            "replace requires at least one of --name, --date, or --note"
        )
    database.execute("BEGIN IMMEDIATE")
    try:
        target = uncorrected_event(database, args.event_id)
        date_changed = hasattr(args, "occurred_on")
        replacement = {
            "id": str(uuid4()),
            "name": args.name if hasattr(args, "name") else target["name"],
            "occurred_at": None if date_changed else target["occurred_at"],
            "occurred_on": (
                args.occurred_on if date_changed else target["occurred_on"]
            ),
            "note": args.note if hasattr(args, "note") else target["note"],
        }
        database.execute(
            """
            INSERT INTO events (id, name, occurred_at, occurred_on, note)
            VALUES (?, ?, ?, ?, ?)
            """,
            tuple(replacement.values()),
        )
        correction = store_correction(
            database,
            kind="replace",
            target_id=args.event_id,
            replacement_id=replacement["id"],
            reason=args.reason,
            now=args.now,
        )
        database.commit()
    except Exception:
        database.rollback()
        raise
    if args.jsonl:
        emit_json(correction_record(correction))
    return 0


def show_activity(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = rows_for_activity(database, args.name)
    if not rows:
        raise ActivityNotFound(args.name)

    latest = rows[0]
    previous = rows[1] if len(rows) > 1 else None
    interval = (
        (occurrence_date(latest) - occurrence_date(previous)).days
        if previous
        else None
    )
    if args.jsonl:
        emit_json(
            {
                "schema_version": 2,
                "type": "summary",
                "name": args.name,
                "last": occurrence_record(latest),
                "previous": occurrence_record(previous) if previous else None,
                "interval_days": interval,
                "occurrences": len(rows),
            }
        )
        return 0

    print(args.name)
    print(f"Last: {occurrence_date(latest).isoformat()}")
    print(
        f"Previous: {occurrence_date(previous).isoformat()}"
        if previous
        else "Previous: -"
    )
    print(f"Interval: {interval} days" if interval is not None else "Interval: -")
    print(f"Occurrences: {len(rows)}")
    return 0


def show_history(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    if args.include_corrections:
        return show_audit_history(database, args)
    rows = rows_for_activity(database, args.name)
    if not rows:
        raise ActivityNotFound(args.name)
    for row in rows:
        if args.jsonl:
            emit_json(event_record(row))
        else:
            print(f"{row['id']}  {occurrence_date(row).isoformat()}")
    return 0


def show_audit_history(
    database: sqlite3.Connection, args: argparse.Namespace
) -> int:
    corrections = database.execute(
        """
        SELECT c.rowid AS insertion_order,
               c.id, c.kind, c.target_id, c.replacement_id,
               c.reason, c.corrected_at
        FROM corrections AS c
        JOIN events AS target ON target.id = c.target_id
        LEFT JOIN events AS replacement ON replacement.id = c.replacement_id
        WHERE target.name = ? OR replacement.name = ?
        ORDER BY c.rowid
        """,
        (args.name, args.name),
    ).fetchall()
    linked_ids = sorted(
        {
            linked_id
            for correction in corrections
            for linked_id in (
                correction["target_id"],
                correction["replacement_id"],
            )
            if linked_id is not None
        }
    )
    placeholders = ",".join("?" for _ in linked_ids)
    linked_clause = f" OR id IN ({placeholders})" if linked_ids else ""
    events = database.execute(
        f"""
        SELECT rowid AS insertion_order,
               id, name, occurred_at, occurred_on, note
        FROM events
        WHERE name = ?{linked_clause}
        ORDER BY rowid
        """,
        (args.name, *linked_ids),
    ).fetchall()
    if not events and not corrections:
        raise ActivityNotFound(args.name)
    for event in events:
        if args.jsonl:
            emit_json(event_record(event))
        else:
            print(f"event {event['id']} {occurrence_date(event).isoformat()}")
    for correction in corrections:
        if args.jsonl:
            emit_json(correction_record(correction))
        else:
            replacement = correction["replacement_id"] or "-"
            print(
                f"correction {correction['id']} {correction['kind']} "
                f"{correction['target_id']} {replacement} "
                f"{correction['corrected_at']} {correction['reason']}"
            )
    return 0


def list_activities(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = database.execute(
        """
        WITH names AS (
            SELECT name
            FROM events
            WHERE NOT EXISTS (
                SELECT 1 FROM corrections WHERE target_id = events.id
            )
            UNION
            SELECT name FROM activities
        )
        SELECT names.name, activities.expected_interval_days
        FROM names
        LEFT JOIN activities ON activities.name = names.name
        ORDER BY names.name COLLATE BINARY
        """
    ).fetchall()
    for row in rows:
        if args.jsonl:
            emit_json(activity_record(row))
        else:
            print(row["name"])
    return 0


def set_interval(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    activity = {
        "name": args.name,
        "expected_interval_days": args.expected_interval_days,
    }
    database.execute(
        """
        INSERT INTO activities (name, expected_interval_days)
        VALUES (?, ?)
        ON CONFLICT(name) DO UPDATE SET
            expected_interval_days = excluded.expected_interval_days
        """,
        tuple(activity.values()),
    )
    database.commit()
    if args.jsonl:
        emit_json(activity_record(activity))
    return 0


def due_record(
    database: sqlite3.Connection,
    activity: sqlite3.Row,
    today: date,
) -> dict[str, Any]:
    rows = rows_for_activity(database, activity["name"])
    if not rows:
        last = None
        due_on = None
        state = "never-recorded"
    else:
        latest = rows[0]
        last = occurrence_record(latest)
        latest_date = occurrence_date(latest)
        due_ordinal = latest_date.toordinal() + activity["expected_interval_days"]
        due_on = (
            date.fromordinal(due_ordinal).isoformat()
            if due_ordinal <= date.max.toordinal()
            else None
        )
        if latest_date > today:
            state = "future-dated"
        elif due_ordinal < today.toordinal():
            state = "overdue"
        elif due_ordinal == today.toordinal():
            state = "due-today"
        else:
            state = "not-due"
    return {
        "schema_version": 2,
        "type": "due",
        **activity_values(activity),
        "last": last,
        "due_on": due_on,
        "state": state,
    }


def show_due(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    activities = database.execute(
        """
        SELECT name, expected_interval_days
        FROM activities
        ORDER BY name COLLATE BINARY
        """
    )
    for activity in activities:
        record = due_record(database, activity, args.now.date())
        if args.overdue and record["state"] != "overdue":
            continue
        if args.jsonl:
            emit_json(record)
        else:
            last_date = (
                occurrence_date(record["last"]).isoformat()
                if record["last"] is not None
                else "-"
            )
            print(
                f"{record['name']}  {last_date}  "
                f"{record['expected_interval_days']}d  "
                f"{record['due_on'] or '-'}  {record['state'].upper()}"
            )
    return 0


def export_events(database: sqlite3.Connection, args: argparse.Namespace) -> int:
    rows = database.execute(
        """
        SELECT id, name, occurred_at, occurred_on, note
        FROM events
        ORDER BY rowid
        """
